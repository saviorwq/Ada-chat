# Normalize text files to LF in the repository (aligns with Linux CI / typical Node tooling).
* text=auto eol=lf

# Windows scripts: keep CRLF for Notepad/cmd compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets (do not touch line endings)
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
